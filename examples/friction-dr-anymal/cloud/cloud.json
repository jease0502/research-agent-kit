{
  "account": "<ACCOUNT_EMAIL>",
  "project": "<gcp-project-id>",
  "bucket": "gs://<bucket>/friction-dr-anymal",
  "image": {"project": "<image-project>", "family": "<image-family with an NVIDIA driver and Vulkan ICD>"},
  "zones": ["<zone-1>", "<zone-2>", "<zone-3>"],
  "machine_type": "g2-standard-8",
  "disk_gb": 300,
  "disk_type": "pd-balanced",
  "provisioning": "STANDARD",
  "max_run": "8h",
  "idle_minutes": 20,
  "service_account": "<SERVICE_ACCOUNT_EMAIL>",
  "price_per_vm_hour": 1.0,
  "report_at_usd": 8,
  "stop_at_usd": 12,
  "labels": {"owner": "<who>", "project": "friction-dr-anymal"},
  "name_prefix": "rak-fdr-",
  "poll_s": 120,
  "stall_min": 45,
  "stop_wait_min": 25,
  "local_dir": "<local folder for pulled outputs>"
}
